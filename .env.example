# ---- Database ----
# For local prototype (default): SQLite file, no setup needed.
DATABASE_URL=sqlite:///./finmate.db
# For production, swap to Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/finmate

# ---- Auth ----
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- AI Provider (optional) ----
# If left empty, FinMate AI automatically falls back to rule-based
# transaction parsing, categorization, and a template-based assistant.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, etc.)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
